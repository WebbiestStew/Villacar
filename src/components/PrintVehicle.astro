---
// Print Vehicle Details Component
interface Props {
  carTitle: string;
}

const { carTitle } = Astro.props;
---

<div class="print-section">
  <button 
    id="printButton"
    class="flex items-center gap-2 px-6 py-3 bg-gray-900 text-white rounded-xl hover:bg-gray-800 transition font-semibold print:hidden"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
    </svg>
    Print Details
  </button>

  <!-- Print-only header -->
  <div class="hidden print:block print-header mb-8">
    <div class="flex items-center justify-between border-b-2 border-gray-300 pb-6 mb-6">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">{carTitle}</h1>
        <p class="text-gray-600">Villacar Autos LLC. - Albuquerque, NM</p>
      </div>
      <div class="text-right">
        <img src="/logo.png" alt="Villacar Logo" class="h-16 mb-2" onerror="this.style.display='none'" />
        <p class="text-sm text-gray-600">Contact: (505) 555-0123</p>
        <p class="text-sm text-gray-600">www.villacar.com</p>
      </div>
    </div>
    <div class="bg-gray-100 p-4 rounded-lg mb-6">
      <p class="text-sm text-gray-700">
        <strong>Printed on:</strong> <span id="printDate"></span>
      </p>
      <p class="text-sm text-gray-700 mt-1">
        <strong>Reference:</strong> This information is accurate as of the print date. Please contact us to verify availability and current pricing.
      </p>
    </div>
  </div>

  <!-- Print-only footer -->
  <div class="hidden print:block print-footer mt-8 pt-6 border-t-2 border-gray-300">
    <div class="grid grid-cols-2 gap-8 mb-6">
      <div>
        <h3 class="font-bold text-gray-900 mb-3">Contact Information</h3>
        <p class="text-sm text-gray-700 mb-2">
          <strong>Phone:</strong> (505) 555-0123
        </p>
        <p class="text-sm text-gray-700 mb-2">
          <strong>Email:</strong> info@villacar.com
        </p>
        <p class="text-sm text-gray-700 mb-2">
          <strong>Address:</strong> 123 Auto Plaza, Albuquerque, NM 87101
        </p>
        <p class="text-sm text-gray-700">
          <strong>Hours:</strong> Mon-Sat 9AM-7PM, Sun 10AM-6PM
        </p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-3">Next Steps</h3>
        <ul class="text-sm text-gray-700 space-y-2">
          <li>✓ Schedule a test drive online or by phone</li>
          <li>✓ Get pre-approved for financing</li>
          <li>✓ Trade in your current vehicle</li>
          <li>✓ Ask about our extended warranties</li>
        </ul>
      </div>
    </div>
    <div class="text-center text-xs text-gray-500 mt-6 pt-4 border-t border-gray-200">
      <p>© 2024 Villacar Autos LLC. All rights reserved. Prices subject to change without notice.</p>
      <p class="mt-1">This is not a binding offer. All sales subject to final approval and verification of information.</p>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  const printButton = document.getElementById('printButton');
  const printDate = document.getElementById('printDate');

  if (printDate) {
    printDate.textContent = new Date().toLocaleString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true
    });
  }

  printButton?.addEventListener('click', () => {
    window.print();
  });

  // Track print events
  window.addEventListener('beforeprint', () => {
    const prints = JSON.parse(localStorage.getItem('vehiclePrints') || '[]');
    prints.push({
      url: window.location.href,
      timestamp: new Date().toISOString()
    });
    localStorage.setItem('vehiclePrints', JSON.stringify(prints));
  });
</script>

<style>
  /* Print Styles */
  @media print {
    /* Reset page */
    @page {
      size: letter;
      margin: 0.75in;
    }

    /* Hide non-essential elements */
    nav, 
    footer, 
    .print\\:hidden,
    button:not(.print\\:block),
    .fixed,
    .sticky,
    [class*="z-"],
    .shadow-xl,
    .shadow-lg,
    .hover\\:,
    .transition,
    .animate-,
    #chatWidget,
    #chatWidgetButton,
    .whatsapp-btn,
    .back-to-top-btn {
      display: none !important;
    }

    /* Show print-only elements */
    .print-header,
    .print-footer {
      display: block !important;
    }

    /* General print styles */
    body {
      background: white !important;
      color: black !important;
      font-size: 11pt;
      line-height: 1.5;
    }

    /* Remove backgrounds and shadows */
    * {
      background: transparent !important;
      box-shadow: none !important;
      text-shadow: none !important;
    }

    /* Keep borders and essential styling */
    .bg-gray-100 {
      background: #f3f4f6 !important;
      border: 1px solid #e5e7eb;
    }

    /* Images */
    img {
      max-width: 100% !important;
      page-break-inside: avoid;
    }

    /* Tables and grids */
    table, 
    .grid {
      page-break-inside: avoid;
    }

    /* Headings */
    h1, h2, h3, h4, h5, h6 {
      page-break-after: avoid;
      font-weight: bold;
      color: #111827 !important;
    }

    h1 {
      font-size: 24pt;
      margin-bottom: 12pt;
    }

    h2 {
      font-size: 18pt;
      margin-top: 12pt;
      margin-bottom: 8pt;
    }

    h3 {
      font-size: 14pt;
      margin-top: 8pt;
      margin-bottom: 6pt;
    }

    /* Paragraphs */
    p {
      orphans: 3;
      widows: 3;
      margin-bottom: 8pt;
    }

    /* Links */
    a {
      text-decoration: underline;
      color: #1f2937 !important;
    }

    a[href]:after {
      content: " (" attr(href) ")";
      font-size: 9pt;
      color: #6b7280;
    }

    /* Lists */
    ul, ol {
      margin-left: 20pt;
      margin-bottom: 8pt;
    }

    li {
      margin-bottom: 4pt;
    }

    /* Borders */
    .border,
    .border-t,
    .border-b {
      border-color: #d1d5db !important;
    }

    /* Spacing adjustments */
    .mb-8,
    .mb-6,
    .mb-4 {
      margin-bottom: 12pt !important;
    }

    .p-8,
    .p-6,
    .p-4 {
      padding: 8pt !important;
    }

    /* Keep specific vehicle detail styling */
    .vehicle-specs {
      border: 1px solid #d1d5db !important;
      padding: 8pt !important;
      margin: 8pt 0 !important;
    }

    /* Page breaks */
    .page-break-before {
      page-break-before: always;
    }

    .page-break-after {
      page-break-after: always;
    }

    .page-break-inside-avoid {
      page-break-inside: avoid;
    }
  }
</style>
