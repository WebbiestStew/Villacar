---
// Live Chat Widget Component
---

<!-- Chat Widget Button -->
<div 
  id="chatWidgetButton" 
  class="fixed bottom-6 right-6 w-16 h-16 bg-gradient-to-br from-red-600 to-red-700 rounded-full shadow-2xl flex items-center justify-center cursor-pointer hover:scale-110 transition-all duration-300 z-40 group"
>
  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
  </svg>
  
  <!-- Notification badge -->
  <span id="chatNotification" class="hidden absolute -top-1 -right-1 w-5 h-5 bg-yellow-400 rounded-full border-2 border-white animate-pulse"></span>
  
  <!-- Tooltip -->
  <div class="absolute right-20 bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-semibold whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
    Chat with us! 💬
  </div>
</div>

<!-- Chat Widget Window -->
<div 
  id="chatWidget" 
  class="hidden fixed bottom-24 right-6 w-96 max-w-[calc(100vw-3rem)] h-[600px] max-h-[calc(100vh-8rem)] bg-white rounded-2xl shadow-2xl z-40 overflow-hidden"
>
  <!-- Header -->
  <div class="bg-gradient-to-r from-red-600 to-red-700 p-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="relative">
        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center">
          <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-400 rounded-full border-2 border-white"></div>
      </div>
      <div>
        <h3 class="font-bold text-white text-lg">Villacar Team</h3>
        <p class="text-red-100 text-xs">Typically replies in minutes</p>
      </div>
    </div>
    <button 
      id="chatClose" 
      class="text-white hover:bg-white/20 rounded-lg p-2 transition"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Messages Area -->
  <div id="chatMessages" class="flex-1 overflow-y-auto p-6 space-y-4 bg-gray-50">
    <!-- Welcome Message (always shows) -->
    <div class="flex items-start gap-3">
      <div class="w-10 h-10 bg-gradient-to-br from-red-600 to-red-700 rounded-full flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <div class="bg-white rounded-2xl rounded-tl-sm p-4 shadow-md max-w-[80%]">
        <p class="text-gray-900 text-sm leading-relaxed">
          <strong>Welcome to Villacar! 👋</strong><br/>
          How can we help you today?
        </p>
        <span class="text-xs text-gray-400 mt-2 block">Just now</span>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="flex flex-col gap-2">
      <button class="quick-action bg-white border-2 border-gray-200 hover:border-red-500 hover:bg-red-50 rounded-xl p-4 text-left transition group">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center group-hover:bg-blue-200 transition">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-gray-900 text-sm">Browse Inventory</div>
            <div class="text-xs text-gray-500">View available vehicles</div>
          </div>
        </div>
      </button>

      <button class="quick-action bg-white border-2 border-gray-200 hover:border-red-500 hover:bg-red-50 rounded-xl p-4 text-left transition group">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center group-hover:bg-green-200 transition">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-gray-900 text-sm">Get Financing</div>
            <div class="text-xs text-gray-500">Check payment options</div>
          </div>
        </div>
      </button>

      <button class="quick-action bg-white border-2 border-gray-200 hover:border-red-500 hover:bg-red-50 rounded-xl p-4 text-left transition group">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center group-hover:bg-purple-200 transition">
            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-gray-900 text-sm">Schedule Test Drive</div>
            <div class="text-xs text-gray-500">Book an appointment</div>
          </div>
        </div>
      </button>

      <button class="quick-action bg-white border-2 border-gray-200 hover:border-red-500 hover:bg-red-50 rounded-xl p-4 text-left transition group">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center group-hover:bg-orange-200 transition">
            <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <div class="font-bold text-gray-900 text-sm">Call Us Now</div>
            <div class="text-xs text-gray-500">(505) 555-0123</div>
          </div>
        </div>
      </button>
    </div>
  </div>

  <!-- Input Area -->
  <div class="border-t-2 border-gray-200 p-4 bg-white">
    <form id="chatForm" class="flex gap-2">
      <input 
        type="text" 
        id="chatInput"
        placeholder="Type your message..."
        class="flex-1 px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-red-500 transition"
      />
      <button 
        type="submit"
        class="px-6 py-3 bg-gradient-to-r from-red-600 to-red-700 text-white rounded-xl hover:from-red-700 hover:to-red-800 transition font-bold shadow-lg"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </form>
    <p class="text-xs text-gray-500 mt-2 text-center">
      We'll respond as soon as possible
    </p>
  </div>
</div>

<style>
  #chatWidget:not(.hidden) {
    display: flex;
    flex-direction: column;
  }
</style>

<script>
  // @ts-nocheck
  const chatWidgetButton = document.getElementById('chatWidgetButton');
  const chatWidget = document.getElementById('chatWidget');
  const chatClose = document.getElementById('chatClose');
  const chatForm = document.getElementById('chatForm');
  const chatInput = document.getElementById('chatInput') as HTMLInputElement;
  const chatMessages = document.getElementById('chatMessages');
  const chatNotification = document.getElementById('chatNotification');
  const quickActions = document.querySelectorAll('.quick-action');

  // Load chat history from localStorage
  function loadChatHistory() {
    const history = JSON.parse(localStorage.getItem('chatHistory') || '[]');
    
    // Skip welcome message and quick actions (first 2 children divs)
    const existingMessages = Array.from(chatMessages?.children || []).slice(2);
    existingMessages.forEach(msg => msg.remove());

    history.forEach(msg => {
      addMessage(msg.text, msg.sender, msg.timestamp, false);
    });
  }

  // Save message to localStorage
  function saveMessage(text: string, sender: 'user' | 'bot') {
    const history = JSON.parse(localStorage.getItem('chatHistory') || '[]');
    history.push({
      text,
      sender,
      timestamp: new Date().toISOString()
    });
    localStorage.setItem('chatHistory', JSON.stringify(history));
  }

  // Add message to chat
  function addMessage(text: string, sender: 'user' | 'bot', timestamp?: string, save = true) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `flex items-start gap-3 ${sender === 'user' ? 'flex-row-reverse' : ''}`;

    const time = timestamp ? new Date(timestamp) : new Date();
    const timeStr = time.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });

    if (sender === 'bot') {
      messageDiv.innerHTML = `
        <div class="w-10 h-10 bg-gradient-to-br from-red-600 to-red-700 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="bg-white rounded-2xl rounded-tl-sm p-4 shadow-md max-w-[80%]">
          <p class="text-gray-900 text-sm leading-relaxed">${text}</p>
          <span class="text-xs text-gray-400 mt-2 block">${timeStr}</span>
        </div>
      `;
    } else {
      messageDiv.innerHTML = `
        <div class="bg-gradient-to-br from-red-600 to-red-700 text-white rounded-2xl rounded-tr-sm p-4 shadow-md max-w-[80%]">
          <p class="text-sm leading-relaxed">${text}</p>
          <span class="text-xs text-red-200 mt-2 block">${timeStr}</span>
        </div>
      `;
    }

    chatMessages?.appendChild(messageDiv);
    chatMessages?.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });

    if (save) {
      saveMessage(text, sender);
    }
  }

  // Simulate bot response
  function botResponse(userMessage: string) {
    const responses = {
      'inventory': "Great! You can browse our entire inventory at any time. We have a wide selection of quality vehicles. Would you like me to direct you to our inventory page?",
      'financing': "We offer competitive financing options! You can use our financing calculator to estimate payments, or contact us for a pre-approval. What vehicle are you interested in?",
      'test drive': "Perfect! I can help you schedule a test drive. Which vehicle would you like to test drive? You can also visit our scheduling page.",
      'call': "You can reach us at (505) 555-0123. We're available Monday-Saturday 9AM-7PM, Sunday 10AM-6PM. Would you prefer we call you instead?",
      'default': "Thanks for your message! A team member will respond shortly. In the meantime, feel free to browse our inventory or check out our financing options."
    };

    const lowerMessage = userMessage.toLowerCase();
    let response = responses.default;

    if (lowerMessage.includes('inventory') || lowerMessage.includes('vehicles') || lowerMessage.includes('cars')) {
      response = responses.inventory;
    } else if (lowerMessage.includes('financ') || lowerMessage.includes('loan') || lowerMessage.includes('payment')) {
      response = responses.financing;
    } else if (lowerMessage.includes('test drive') || lowerMessage.includes('appointment')) {
      response = responses['test drive'];
    } else if (lowerMessage.includes('call') || lowerMessage.includes('phone')) {
      response = responses.call;
    }

    setTimeout(() => {
      addMessage(response, 'bot');
    }, 1000 + Math.random() * 1000);
  }

  // Toggle chat
  chatWidgetButton?.addEventListener('click', () => {
    const isHidden = chatWidget?.classList.contains('hidden');
    if (isHidden) {
      chatWidget?.classList.remove('hidden');
      chatNotification?.classList.add('hidden');
      loadChatHistory();
    } else {
      chatWidget?.classList.add('hidden');
    }
  });

  chatClose?.addEventListener('click', () => {
    chatWidget?.classList.add('hidden');
  });

  // Handle message submission
  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const message = chatInput?.value.trim();
    if (message) {
      addMessage(message, 'user');
      chatInput.value = '';
      botResponse(message);
    }
  });

  // Quick action buttons
  quickActions.forEach((button, index) => {
    button.addEventListener('click', () => {
      const actions = [
        { text: "I'd like to browse your inventory", response: "inventory" },
        { text: "I'm interested in financing options", response: "financing" },
        { text: "I want to schedule a test drive", response: "test drive" },
        { text: "I'd like to speak with someone", response: "call" }
      ];

      const action = actions[index];
      if (action) {
        addMessage(action.text, 'user');
        botResponse(action.response);
      }
    });
  });

  // Show notification badge after 10 seconds (simulating new message)
  setTimeout(() => {
    if (chatWidget?.classList.contains('hidden')) {
      chatNotification?.classList.remove('hidden');
    }
  }, 10000);
</script>

<style>
  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  #chatMessages::-webkit-scrollbar {
    width: 8px;
  }

  #chatMessages::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
  }

  #chatMessages::-webkit-scrollbar-thumb {
    background: #dc2626;
    border-radius: 10px;
  }

  #chatMessages::-webkit-scrollbar-thumb:hover {
    background: #b91c1c;
  }
</style>
