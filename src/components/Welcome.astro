---
import { getFeaturedCars, cars, type Car } from '../data/cars';

const featuredCars = getFeaturedCars();
---

<main class="bg-white">
  <!-- Hero Section -->
  <section class="relative min-h-[600px] flex items-center justify-center bg-gradient-to-br from-gray-900 to-gray-800">
    <div class="container mx-auto px-4 text-center text-white py-20">
      <h1 class="text-5xl md:text-7xl font-bold mb-6">
        Find Your Perfect <span class="text-red-500">Vehicle</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 mb-10 max-w-3xl mx-auto">
        Quality pre-owned and new vehicles from trusted brands
      </p>
      <a 
        href="/inventory" 
        class="inline-block px-10 py-4 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-all duration-300 font-bold text-lg shadow-lg"
      >
        Browse Inventory
      </a>
    </div>
  </section>

  <!-- Featured Vehicles -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Featured Vehicles</h2>
        <p class="text-xl text-gray-600">Check out our handpicked selection</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
        {featuredCars.map((car) => (
          <a href={`/cars/${car.id}`} class="group">
            <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
              <div class="relative overflow-hidden h-56">
                <img 
                  src={car.images[0]} 
                  alt={`${car.make} ${car.model}`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
                <div class="absolute top-4 right-4">
                  <span class={`px-3 py-1 rounded-full text-xs font-bold ${
                    car.condition === 'New' ? 'bg-green-600 text-white' :
                    car.condition === 'Certified' ? 'bg-blue-600 text-white' :
                    'bg-gray-700 text-white'
                  }`}>
                    {car.condition}
                  </span>
                </div>
              </div>
              
              <div class="p-5">
                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-red-600 transition-colors">
                  {car.year} {car.make} {car.model}
                </h3>
                
                <div class="flex items-center text-sm text-gray-600 mb-4 space-x-3">
                  <span>{car.mileage.toLocaleString()} mi</span>
                  <span>•</span>
                  <span>{car.fuelType}</span>
                </div>

                <div class="flex justify-between items-center pt-3 border-t border-gray-100">
                  <span class="text-2xl font-bold text-red-600">
                    ${car.price.toLocaleString()}
                  </span>
                  <span class="text-red-600 font-semibold group-hover:translate-x-1 transition-transform">
                    →
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center">
        <a 
          href="/inventory" 
          class="inline-block px-8 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-all font-bold"
        >
          View All {cars.length} Vehicles
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Why Choose Us</h2>
        <p class="text-xl text-gray-600">Your trusted dealership since 2001</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center p-6">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Quality Assured</h3>
          <p class="text-gray-600">Every vehicle thoroughly inspected</p>
        </div>

        <div class="text-center p-6">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Great Financing</h3>
          <p class="text-gray-600">Flexible options to fit your budget</p>
        </div>

        <div class="text-center p-6">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Expert Team</h3>
          <p class="text-gray-600">Knowledgeable staff ready to help</p>
        </div>

        <div class="text-center p-6">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Customer First</h3>
          <p class="text-gray-600">Your satisfaction is our priority</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recently Viewed -->
  <section id="recentlyViewedSection" class="py-20 bg-gray-50 hidden">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Recently Viewed</h2>
        <p class="text-xl text-gray-600">Pick up where you left off</p>
      </div>

      <div id="recentlyViewedGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Will be populated by JavaScript -->
      </div>
    </div>
  </section>
</main>

<script define:vars={{ cars }}>
  // Recently Viewed functionality
  function loadRecentlyViewed() {
    const recentlyViewed = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
    
    if (recentlyViewed.length === 0) {
      return;
    }

    const section = document.getElementById('recentlyViewedSection');
    const grid = document.getElementById('recentlyViewedGrid');
    
    section?.classList.remove('hidden');

    const viewedCars = recentlyViewed
      .map(id => cars.find(c => c.id === id))
      .filter(Boolean)
      .slice(0, 4);

    if (grid) {
      grid.innerHTML = viewedCars.map(car => `
        <a href="/cars/${car.id}" class="group">
          <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
            <div class="relative overflow-hidden h-56">
              <img 
                src="${car.images[0]}" 
                alt="${car.make} ${car.model}"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
              <div class="absolute top-4 right-4">
                <span class="px-3 py-1 rounded-full text-xs font-bold ${
                  car.condition === 'New' ? 'bg-green-600 text-white' :
                  car.condition === 'Certified' ? 'bg-blue-600 text-white' :
                  'bg-gray-700 text-white'
                }">
                  ${car.condition}
                </span>
              </div>
            </div>
            
            <div class="p-5">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-red-600 transition-colors">
                ${car.year} ${car.make} ${car.model}
              </h3>
              
              <div class="flex items-center text-sm text-gray-600 mb-4 space-x-3">
                <span>${car.mileage.toLocaleString()} mi</span>
                <span>•</span>
                <span>${car.fuelType}</span>
              </div>

              <div class="flex justify-between items-center pt-3 border-t border-gray-100">
                <span class="text-2xl font-bold text-red-600">
                  $${car.price.toLocaleString()}
                </span>
                <span class="text-red-600 font-semibold group-hover:translate-x-1 transition-transform">
                  →
                </span>
              </div>
            </div>
          </div>
        </a>
      `).join('');
    }
  }

  loadRecentlyViewed();
</script>
