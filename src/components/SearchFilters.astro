---
const { makes, bodyTypes } = Astro.props;
---

<div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-2xl p-8 -mt-10 relative z-10">
  <!-- Search Bar -->
  <div class="mb-6">
    <input 
      type="text" 
      id="searchInput" 
      placeholder="Search by make, model, year..." 
      class="w-full px-6 py-4 text-lg rounded-xl border-2 border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
    />
  </div>

  <!-- Advanced Filters Toggle -->
  <div class="flex justify-between items-center mb-4">
    <h3 class="text-lg font-semibold text-gray-800">Filters</h3>
    <button 
      id="toggleAdvanced" 
      class="text-red-600 hover:text-red-700 font-medium flex items-center gap-2"
    >
      <span id="toggleText">Show Advanced</span>
      <svg id="toggleIcon" class="w-5 h-5 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
  </div>

  <!-- Basic Filters -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
    <select id="makeFilter" class="px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500">
      <option value="">All Makes</option>
      {makes.map((make: string) => <option value={make}>{make}</option>)}
    </select>
    
    <select id="bodyTypeFilter" class="px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500">
      <option value="">All Body Types</option>
      {bodyTypes.map((type: string) => <option value={type}>{type}</option>)}
    </select>
    
    <select id="conditionFilter" class="px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500">
      <option value="">All Conditions</option>
      <option value="New">New</option>
      <option value="Used">Used</option>
      <option value="Certified">Certified</option>
    </select>

    <select id="sortBy" class="px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500">
      <option value="featured">Featured First</option>
      <option value="price-low">Price: Low to High</option>
      <option value="price-high">Price: High to Low</option>
      <option value="year-new">Year: Newest First</option>
      <option value="mileage-low">Mileage: Low to High</option>
    </select>
  </div>

  <!-- Advanced Filters (Hidden by default) -->
  <div id="advancedFilters" class="hidden space-y-4 mt-6 pt-6 border-t border-gray-200">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Price Range -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Price Range</label>
        <div class="flex gap-2">
          <input 
            type="number" 
            id="minPrice" 
            placeholder="Min" 
            class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
          />
          <input 
            type="number" 
            id="maxPrice" 
            placeholder="Max" 
            class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
          />
        </div>
      </div>

      <!-- Year Range -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Year Range</label>
        <div class="flex gap-2">
          <input 
            type="number" 
            id="minYear" 
            placeholder="Min" 
            class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
          />
          <input 
            type="number" 
            id="maxYear" 
            placeholder="Max" 
            class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
          />
        </div>
      </div>

      <!-- Mileage Range -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Mileage Range</label>
        <div class="flex gap-2">
          <input 
            type="number" 
            id="minMileage" 
            placeholder="Min" 
            class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
          />
          <input 
            type="number" 
            id="maxMileage" 
            placeholder="Max" 
            class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
          />
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Fuel Type -->
      <select id="fuelTypeFilter" class="px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500">
        <option value="">All Fuel Types</option>
        <option value="Gasoline">Gasoline</option>
        <option value="Diesel">Diesel</option>
        <option value="Electric">Electric</option>
        <option value="Hybrid">Hybrid</option>
      </select>

      <!-- Transmission -->
      <select id="transmissionFilter" class="px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500">
        <option value="">All Transmissions</option>
        <option value="Automatic">Automatic</option>
        <option value="Manual">Manual</option>
      </select>

      <!-- Color -->
      <input 
        type="text" 
        id="colorFilter" 
        placeholder="Color (e.g., Black, White)" 
        class="px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
      />
    </div>

    <div class="flex gap-4">
      <button 
        id="clearFilters" 
        class="px-6 py-2 border-2 border-red-600 text-red-600 rounded-lg hover:bg-red-50 transition font-medium"
      >
        Clear All Filters
      </button>
    </div>
  </div>

  <!-- Results Count -->
  <div class="mt-6 pt-6 border-t border-gray-200">
    <p id="resultsCount" class="text-gray-600 text-center">
      Showing all vehicles
    </p>
  </div>
</div>

<script>
  // @ts-nocheck
  const advancedFilters = document.getElementById('advancedFilters');
  const toggleBtn = document.getElementById('toggleAdvanced');
  const toggleText = document.getElementById('toggleText');
  const toggleIcon = document.getElementById('toggleIcon');

  toggleBtn?.addEventListener('click', () => {
    advancedFilters?.classList.toggle('hidden');
    const isHidden = advancedFilters?.classList.contains('hidden');
    if (toggleText) toggleText.textContent = isHidden ? 'Show Advanced' : 'Hide Advanced';
    toggleIcon?.classList.toggle('rotate-180');
  });
</script>
