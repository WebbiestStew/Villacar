---
// Vehicle Availability Checker Component
interface Props {
  carId: string;
  carTitle: string;
}

const { carId, carTitle } = Astro.props;
---

<div class="availability-checker">
  <button 
    id="availabilityButton"
    class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-green-600 text-white rounded-xl hover:bg-green-700 transition font-semibold shadow-lg"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    Check Availability
  </button>

  <!-- Availability Modal -->
  <div id="availabilityModal" class="modal-hidden fixed inset-0 bg-black/50 z-50 p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-8 relative animate-fadeIn">
      <!-- Close Button -->
      <button 
        id="closeAvailabilityModal"
        class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Available Status -->
      <div id="availableStatus" class="text-center">
        <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>

        <h3 class="text-2xl font-bold text-gray-900 mb-2">This Vehicle is Available!</h3>
        <p class="text-gray-600 mb-6">We have this vehicle in stock and ready for test drive or purchase.</p>

        <div class="bg-green-50 rounded-xl p-6 mb-6">
          <div class="grid grid-cols-2 gap-4 text-left">
            <div>
              <div class="text-sm text-gray-600 mb-1">Status</div>
              <div class="font-bold text-green-700">In Stock</div>
            </div>
            <div>
              <div class="text-sm text-gray-600 mb-1">Location</div>
              <div class="font-bold text-gray-900">Albuquerque, NM</div>
            </div>
            <div>
              <div class="text-sm text-gray-600 mb-1">Test Drive</div>
              <div class="font-bold text-gray-900">Same Day</div>
            </div>
            <div>
              <div class="text-sm text-gray-600 mb-1">Financing</div>
              <div class="font-bold text-gray-900">Available</div>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <button 
            id="scheduleTestDrive"
            class="w-full px-6 py-4 bg-red-600 text-white rounded-xl hover:bg-red-700 transition font-bold shadow-lg"
          >
            Schedule Test Drive
          </button>
          <button 
            id="contactAboutCar"
            class="w-full px-6 py-4 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-red-500 hover:text-red-600 transition font-semibold"
          >
            Contact Us About This Vehicle
          </button>
        </div>

        <p class="text-sm text-gray-500 mt-6">
          💡 <strong>Pro Tip:</strong> This vehicle is popular! Schedule a test drive today to secure your spot.
        </p>
      </div>

      <!-- Contact Form -->
      <div id="contactForm" class="hidden">
        <div class="text-center mb-6">
          <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Get More Information</h3>
          <p class="text-gray-600">We'll respond within 1 business hour</p>
        </div>

        <form id="availabilityContactForm" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Your Name *</label>
            <input 
              type="text" 
              name="name"
              required
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 transition"
              placeholder="John Doe"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Email *</label>
            <input 
              type="email" 
              name="email"
              required
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 transition"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Phone *</label>
            <input 
              type="tel" 
              name="phone"
              required
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 transition"
              placeholder="(505) 555-0123"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Questions (Optional)</label>
            <textarea 
              name="questions"
              rows="3"
              class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-red-500 transition"
              placeholder="Any specific questions about this vehicle?"
            ></textarea>
          </div>

          <div class="flex gap-3">
            <button 
              type="button"
              id="backToStatus"
              class="flex-1 px-6 py-3 border-2 border-gray-300 text-gray-700 rounded-xl hover:border-gray-400 transition font-semibold"
            >
              Back
            </button>
            <button 
              type="submit"
              class="flex-1 px-6 py-3 bg-red-600 text-white rounded-xl hover:bg-red-700 transition font-bold"
            >
              Send Inquiry
            </button>
          </div>
        </form>

        <!-- Success Message -->
        <div id="formSuccess" class="hidden mt-4 p-4 bg-green-50 border-2 border-green-200 rounded-xl">
          <div class="flex items-center gap-2 text-green-800">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-semibold">Message sent! We'll contact you soon.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-hidden {
    display: none;
  }
  
  #availabilityModal:not(.modal-hidden) {
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script define:vars={{ carId, carTitle }}>
  // @ts-nocheck
  const availabilityButton = document.getElementById('availabilityButton');
  const availabilityModal = document.getElementById('availabilityModal');
  const closeAvailabilityModal = document.getElementById('closeAvailabilityModal');
  const availableStatus = document.getElementById('availableStatus');
  const contactForm = document.getElementById('contactForm');
  const contactAboutCar = document.getElementById('contactAboutCar');
  const backToStatus = document.getElementById('backToStatus');
  const availabilityContactForm = document.getElementById('availabilityContactForm');
  const formSuccess = document.getElementById('formSuccess');
  const scheduleTestDrive = document.getElementById('scheduleTestDrive');

  // Open modal
  availabilityButton?.addEventListener('click', () => {
    availabilityModal?.classList.remove('modal-hidden');
    availableStatus?.classList.remove('hidden');
    contactForm?.classList.add('hidden');
  });

  // Close modal
  closeAvailabilityModal?.addEventListener('click', () => {
    availabilityModal?.classList.add('modal-hidden');
  });

  // Close on outside click
  availabilityModal?.addEventListener('click', (e) => {
    if (e.target === availabilityModal) {
      availabilityModal.classList.add('modal-hidden');
    }
  });

  // Show contact form
  contactAboutCar?.addEventListener('click', () => {
    availableStatus?.classList.add('hidden');
    contactForm?.classList.remove('hidden');
  });

  // Back to status
  backToStatus?.addEventListener('click', () => {
    contactForm?.classList.add('hidden');
    availableStatus?.classList.remove('hidden');
  });

  // Schedule test drive (redirect to test drive page or section)
  scheduleTestDrive?.addEventListener('click', () => {
    // In production, this could scroll to test drive scheduler or open it
    alert('This would open the test drive scheduler for this specific vehicle!');
  });

  // Handle form submission
  availabilityContactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(availabilityContactForm);
    const inquiry = {
      carId,
      carTitle,
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      questions: formData.get('questions'),
      type: 'availability',
      submittedAt: new Date().toISOString()
    };

    // Store inquiry
    const inquiries = JSON.parse(localStorage.getItem('vehicleInquiries') || '[]');
    inquiries.push(inquiry);
    localStorage.setItem('vehicleInquiries', JSON.stringify(inquiries));

    // Show success
    formSuccess?.classList.remove('hidden');
    availabilityContactForm.reset();

    // Close modal after 3 seconds
    setTimeout(() => {
      availabilityModal?.classList.add('modal-hidden');
      formSuccess?.classList.add('hidden');
    }, 3000);
  });
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.2s ease-out;
  }
</style>
