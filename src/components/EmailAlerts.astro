---
---

<div class="bg-gradient-to-br from-red-50 to-white rounded-2xl shadow-xl p-8">
  <div class="flex items-center gap-3 mb-6">
    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
    </svg>
    <h2 class="text-3xl font-bold text-gray-900">Get Notified</h2>
  </div>
  
  <p class="text-gray-600 mb-8">
    Subscribe to receive alerts when new vehicles matching your preferences arrive in our inventory
  </p>

  <form id="alertSubscriptionForm" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="alertName" class="block text-sm font-medium text-gray-700 mb-2">
          Full Name *
        </label>
        <input 
          type="text" 
          id="alertName" 
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
        />
      </div>

      <div>
        <label for="alertEmail" class="block text-sm font-medium text-gray-700 mb-2">
          Email Address *
        </label>
        <input 
          type="email" 
          id="alertEmail" 
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
        />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-3">
        Preferred Vehicle Types
      </label>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="Sedan" class="vehicle-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">Sedan</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="SUV" class="vehicle-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">SUV</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="Truck" class="vehicle-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">Truck</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="Coupe" class="vehicle-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">Coupe</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="Convertible" class="vehicle-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">Convertible</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="Hatchback" class="vehicle-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">Hatchback</span>
        </label>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="alertPriceMin" class="block text-sm font-medium text-gray-700 mb-2">
          Min Price ($)
        </label>
        <input 
          type="number" 
          id="alertPriceMin" 
          placeholder="10000"
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
        />
      </div>

      <div>
        <label for="alertPriceMax" class="block text-sm font-medium text-gray-700 mb-2">
          Max Price ($)
        </label>
        <input 
          type="number" 
          id="alertPriceMax" 
          placeholder="50000"
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500"
        />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-3">
        Condition Preferences
      </label>
      <div class="flex gap-4">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="New" class="condition-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">New</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="Used" class="condition-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">Used</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="Certified" class="condition-type rounded text-red-600 focus:ring-red-500" />
          <span class="text-sm">Certified Pre-Owned</span>
        </label>
      </div>
    </div>

    <div class="flex items-start gap-3">
      <input 
        type="checkbox" 
        id="alertConsent" 
        required
        class="mt-1 rounded text-red-600 focus:ring-red-500"
      />
      <label for="alertConsent" class="text-sm text-gray-600">
        I agree to receive email notifications about new inventory. You can unsubscribe at any time.
      </label>
    </div>

    <button 
      type="submit"
      class="w-full bg-gradient-to-r from-red-600 to-red-700 text-white py-4 rounded-xl font-bold text-lg hover:from-red-700 hover:to-red-800 transition shadow-lg"
    >
      Subscribe to Alerts
    </button>
  </form>

  <p class="text-xs text-gray-500 text-center mt-4">
    We respect your privacy. Your information will only be used to send you relevant vehicle alerts.
  </p>
</div>

<script>
  // @ts-nocheck
  document.getElementById('alertSubscriptionForm')?.addEventListener('submit', (e) => {
    e.preventDefault();

    const vehicleTypes = Array.from(document.querySelectorAll('.vehicle-type:checked'))
      .map(checkbox => checkbox.value);
    
    const conditions = Array.from(document.querySelectorAll('.condition-type:checked'))
      .map(checkbox => checkbox.value);

    const subscription = {
      name: document.getElementById('alertName').value,
      email: document.getElementById('alertEmail').value,
      vehicleTypes: vehicleTypes.length > 0 ? vehicleTypes : ['Any'],
      priceMin: parseInt(document.getElementById('alertPriceMin').value) || 0,
      priceMax: parseInt(document.getElementById('alertPriceMax').value) || Infinity,
      conditions: conditions.length > 0 ? conditions : ['New', 'Used', 'Certified'],
      subscribedAt: new Date().toISOString(),
      active: true
    };

    // Store in localStorage (in production, send to backend)
    const subscriptions = JSON.parse(localStorage.getItem('alertSubscriptions') || '[]');
    
    // Check if email already exists
    const existing = subscriptions.findIndex(sub => sub.email === subscription.email);
    if (existing >= 0) {
      subscriptions[existing] = subscription;
      alert('✅ Your alert preferences have been updated!');
    } else {
      subscriptions.push(subscription);
      alert('✅ Subscription successful! You\'ll receive email alerts when new vehicles matching your preferences arrive.');
    }
    
    localStorage.setItem('alertSubscriptions', JSON.stringify(subscriptions));

    // Reset form
    document.getElementById('alertSubscriptionForm').reset();
  });
</script>
