---
// Special Offers Component - Display promotional deals and offers
const offers = [
  {
    id: 1,
    title: "Military & First Responder Discount",
    description: "Thank you for your service! Get $500 off any vehicle purchase.",
    discount: "$500 OFF",
    icon: "🎖️",
    color: "blue",
    terms: "Valid military ID or first responder credentials required. Cannot be combined with other offers."
  },
  {
    id: 2,
    title: "Trade-In Bonus",
    description: "Get an extra $750 trade-in value on your current vehicle.",
    discount: "$750 BONUS",
    icon: "🚗",
    color: "green",
    terms: "Must trade in a vehicle valued at $2,000 or more. Offer expires end of month."
  },
  {
    id: 3,
    title: "Student Discount Program",
    description: "Recent graduate? Get special financing rates and $300 off.",
    discount: "$300 OFF",
    icon: "🎓",
    color: "purple",
    terms: "Valid student ID or diploma from last 2 years required. Subject to credit approval."
  },
  {
    id: 5,
    title: "0% Financing Available",
    description: "Qualified buyers can get 0% APR for up to 60 months on select vehicles.",
    discount: "0% APR",
    icon: "💳",
    color: "red",
    terms: "Subject to credit approval. Select vehicles only. See dealer for details."
  },
  {
    id: 6,
    title: "Weekend Special",
    description: "Visit us this weekend and get free premium detailing with purchase!",
    discount: "FREE DETAIL",
    icon: "✨",
    color: "indigo",
    terms: "Saturday and Sunday only. $200 value. Full interior and exterior detail."
  }
];

const colorClasses: Record<string, string> = {
  blue: 'from-blue-500 to-blue-600',
  green: 'from-green-500 to-green-600',
  purple: 'from-purple-500 to-purple-600',
  orange: 'from-orange-500 to-orange-600',
  red: 'from-red-500 to-red-600',
  indigo: 'from-indigo-500 to-indigo-600'
};
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="inline-block px-4 py-2 bg-red-100 text-red-600 rounded-full text-sm font-bold mb-4">
        💰 SPECIAL OFFERS
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Save Big on Your <span class="text-red-600">Next Vehicle</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Take advantage of our current promotions and discounts. Don't miss out on these limited-time offers!
      </p>
    </div>

    <!-- Offers Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {offers.map(offer => (
        <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 overflow-hidden">
          <!-- Offer Badge -->
          <div class={`bg-gradient-to-r ${colorClasses[offer.color]} p-6 text-white text-center`}>
            <div class="text-5xl mb-2">{offer.icon}</div>
            <div class="text-3xl font-bold">{offer.discount}</div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">{offer.title}</h3>
            <p class="text-gray-600 mb-4 leading-relaxed">{offer.description}</p>
            
            <!-- Terms Toggle -->
            <button 
              class="text-sm text-gray-500 hover:text-gray-700 underline offer-terms-toggle"
              data-offer-id={offer.id}
            >
              View Terms & Conditions
            </button>
            
            <div class="offer-terms hidden mt-3 p-3 bg-gray-50 rounded-lg text-xs text-gray-600 leading-relaxed">
              {offer.terms}
            </div>

            <!-- CTA -->
            <div class="mt-6 pt-6 border-t border-gray-200">
              <a 
                href="/inventory" 
                class={`block w-full text-center px-6 py-3 bg-gradient-to-r ${colorClasses[offer.color]} text-white font-bold rounded-xl hover:opacity-90 transition`}
              >
                Shop Inventory →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner CTA -->
    <div class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl p-12 text-center text-white">
      <h3 class="text-3xl font-bold mb-4">Ready to Save?</h3>
      <p class="text-xl text-gray-300 mb-8">
        Our team is ready to help you take advantage of these offers
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a 
          href="/contact" 
          class="px-8 py-4 bg-red-600 text-white rounded-xl font-bold hover:bg-red-700 transition shadow-lg"
        >
          Contact Us Today
        </a>
        <a 
          href="tel:+15055550123" 
          class="px-8 py-4 border-2 border-white text-white rounded-xl font-bold hover:bg-white/10 transition"
        >
          Call (505) 555-0123
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  document.querySelectorAll('.offer-terms-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const terms = button.nextElementSibling;
      const isHidden = terms?.classList.contains('hidden');
      
      if (isHidden) {
        terms?.classList.remove('hidden');
        button.textContent = 'Hide Terms & Conditions';
      } else {
        terms?.classList.add('hidden');
        button.textContent = 'View Terms & Conditions';
      }
    });
  });
</script>
